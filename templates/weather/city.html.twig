{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var forecast \App\Entity\Forecast[] #}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <ul>
            {% for forecast in forecasts %}
                <li>{{ forecast.date|date('d.m.Y') }}: {{ forecast.temperature }}&deg;C ({{ forecast.feelsLike }}&deg;C), Wind: {{ forecast.wind }}km/h, Cloud Coverage: {{ forecast.cloudiness }}%</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
