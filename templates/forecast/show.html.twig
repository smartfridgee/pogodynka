{% extends 'base.html.twig' %}

{% block title %}Forecast{% endblock %}

{% block body %}
<a href="{{ path('app_forecast_index') }}" class="btn btn-sm btn-outline-secondary">back to list</a>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="mt-3">Forecast</h1>
    <a href="{{ path('app_forecast_edit', {'id': forecast.id}) }}" class="btn btn-primary">Edit</a>
</div>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ forecast.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ forecast.date ? forecast.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Temperature</th>
                <td>{{ forecast.temperature }}</td>
            </tr>
            <tr>
                <th>Wind</th>
                <td>{{ forecast.wind }}</td>
            </tr>
            <tr>
                <th>FeelsLike</th>
                <td>{{ forecast.feelsLike }}</td>
            </tr>
            <tr>
                <th>Cloudiness</th>
                <td>{{ forecast.cloudiness }}</td>
            </tr>
            <tr>
                <th>For Location</th>
                <td>{{ forecast.location.city }}</td>
            </tr>
        </tbody>
    </table>

    {{ include('forecast/_delete_form.html.twig') }}
{% endblock %}
